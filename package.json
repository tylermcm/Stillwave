{
  "name": "stillwave",
  "version": "0.4.3",
  "private": true,
  "main": "index.ts",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "android:apk": "pwsh -File scripts/build-android-apk.ps1",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "export:check": "node scripts/export-check.mjs",
    "guide:build": "tsx scripts/audit-guide-coverage.ts --build",
    "guide:audit": "tsx scripts/audit-guide-gaps.ts",
    "guide:catalog": "tsx scripts/sync-guide-stations.ts",
    "guide:serve": "node scripts/serve-guide.mjs",
    "check": "pnpm typecheck && pnpm test"
  },
  "dependencies": {
    "@expo/vector-icons": "15.0.2",
    "expo": "~58.0.19",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.11",
    "expo-navigation-bar": "~58.0.4",
    "expo-network": "~58.0.4",
    "expo-screen-orientation": "~58.0.3",
    "expo-splash-screen": "~58.0.11",
    "expo-status-bar": "~58.0.4",
    "expo-video": "~58.0.12",
    "fflate": "^0.8.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4",
    "saxes": "^6.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "~19.3.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
