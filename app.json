{
  "expo": {
    "name": "StillWave",
    "slug": "stillwave",
    "version": "0.4.11",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stillwave.player",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.stillwave.player",
      "versionCode": 18,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/stillwave-mark-v2.png",
        "backgroundColor": "#0b0f10"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.VIBRATE"
      ]
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": true
        }
      ],
      "./plugins/withPipLifecycle.cjs",
      "expo-screen-orientation",
      "./plugins/withCleartext.cjs",
      "./plugins/withTvRemote.cjs",
      "./plugins/withMobileCutout.cjs",
      "./plugins/withLauncherIcon.cjs",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0b0f10",
          "image": "./assets/branding/stillwave-mark-v2.png",
          "imageWidth": 168,
          "resizeMode": "contain"
        }
      ]
    ],
    "web": {
      "bundler": "metro",
      "name": "StillWave"
    }
  }
}
